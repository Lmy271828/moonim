// Package: browser playground entry. Builds to the js target
// (`moon build --target js playground`) and registers a `moonim` API
// object on globalThis for playground/index.html to drive.

import {
  "Lmy271828/moonim/math",
  "Lmy271828/moonim/geom",
  "Lmy271828/moonim/mobject",
  "Lmy271828/moonim/anim",
  "Lmy271828/moonim/tex",
  "Lmy271828/moonim/graph",
  "Lmy271828/moonim/backend/svg",
  "moonbitlang/core/math" @core_math,
}

pkgtype(kind: "executable")

// On non-js targets only the stub main remains, so every import looks
// unused there; that is intentional, not dead code.

warnings = "-29"

options(
  targets: {
    "main_js.mbt": [ "js" ],
    "main_wasm.mbt": [ "wasm", "wasm-gc" ],
    "main_native.mbt": [ "native" ],
  },
)
