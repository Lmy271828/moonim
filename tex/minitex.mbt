///|
/// The built-in subset formula renderer.
///
/// Supported syntax (v0.1): plain characters, `{...}` grouping, `\frac`,
/// superscript `^`, subscript `_`, and a small set of Greek letter
/// commands. Glyphs come from the embedded Latin Modern subset
/// (`glyphs_data.mbt`, generated by tools/extract_glyphs.py); characters
/// outside the subset fall back to placeholder half-em boxes. The layout
/// itself follows the TeX box model (baseline, fraction rule, script
/// raises), so extending coverage is a data change, not a code change.
pub(all) struct MiniTex {}

///|
pub fn MiniTex::new() -> MiniTex {
  MiniTex::{  }
}

///|
/// Parse and lay out the formula into labeled boxes, or fail.
fn typeset(formula : String, size : Double) -> Result[Array[Box], RenderError] {
  if formula.is_empty() {
    return Err(EmptyFormula)
  }
  if not_balanced(formula) {
    return Err(UnbalancedBraces)
  }
  let parser = Parser::new(formula)
  match parser.parse_expr() {
    Err(e) => Err(e)
    Ok(nodes) => {
      let (_, boxes) = layout(nodes, size)
      Ok(boxes)
    }
  }
}

///|
/// One box as a path: the embedded glyph outline when available,
/// otherwise the placeholder/rule line-rectangle.
fn box_path(b : Box) -> @geom.Path {
  match b.glyph {
    Some(g) => glyph_path(g, b.x, b.y, b.h)
    None => {
      let path = @geom.Path::new()
      path.move_to(@math.Vec2::new(b.x, b.y))
      path.line_to(@math.Vec2::new(b.x + b.w, b.y))
      path.line_to(@math.Vec2::new(b.x + b.w, b.y + b.h))
      path.line_to(@math.Vec2::new(b.x, b.y + b.h))
      path.close()
      path
    }
  }
}

///|
pub impl FormulaRenderer for MiniTex with fn render(self, formula, size) {
  ignore(self)
  match typeset(formula, size) {
    Err(e) => Err(e)
    Ok(boxes) => {
      let path = @geom.Path::new()
      for b in boxes {
        for seg in box_path(b).segments {
          path.segments.push(seg)
        }
      }
      Ok(path)
    }
  }
}

///|
/// Typeset like `render`, but keep the per-symbol structure: one labeled
/// outline per glyph box / fraction rule, in layout order. This is the
/// input for `Mobject::tex` and symbol-level part matching
/// (docs/design.md §3.1, layer L1).
pub fn MiniTex::render_symbols(
  self : MiniTex,
  formula : String,
  size : Double,
) -> Result[Array[(String, @geom.Path)], RenderError] {
  ignore(self)
  match typeset(formula, size) {
    Err(e) => Err(e)
    Ok(boxes) => Ok(boxes.map(fn(b) { (b.label, box_path(b)) }))
  }
}

///|
fn not_balanced(s : String) -> Bool {
  let mut depth = 0
  let mut unbalanced = false
  ignore(
    s.fold(init=0, fn(acc, c) {
      if c == '{' {
        depth = acc + 1
        depth
      } else if c == '}' {
        depth = acc - 1
        if depth < 0 {
          unbalanced = true
        }
        depth
      } else {
        acc
      }
    }),
  )
  unbalanced || depth != 0
}
